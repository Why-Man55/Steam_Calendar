<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee https://jakarta.ee/web-app_6_0.xsd"
         version="6.0">

    <filter>
        <filter-name>mainFilter</filter-name>
        <filter-class>org.example.view.MainFilter</filter-class>
    </filter>
    <servlet>
        <servlet-name>registerServlet</servlet-name>
        <servlet-class>org.example.view.RegisterServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>loginServlet</servlet-name>
        <servlet-class>org.example.view.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>accountInfoServlet</servlet-name>
        <servlet-class>org.example.view.AccountInfoServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>mainSearchServlet</servlet-name>
        <servlet-class>org.example.view.MainSearchServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>logoutServlet</servlet-name>
        <servlet-class>org.example.view.LogoutServlet</servlet-class>
    </servlet>

    <filter-mapping>
        <filter-name>mainFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <servlet-mapping>
        <servlet-name>registerServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>loginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>accountInfoServlet</servlet-name>
        <url-pattern>/account</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>mainSearchServlet</servlet-name>
        <url-pattern></url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>logoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
</web-app>